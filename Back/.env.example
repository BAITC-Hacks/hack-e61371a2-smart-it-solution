# Local backend configuration. Existing Back/.env is never overwritten automatically.
API_PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://career_quest:career_quest_local_only@localhost:5433/career_quest
DEMO_MODE=true
COOKIE_SECURE=false
DATASET_PATH=./data

# OpenAI is opt-in; key belongs only on the server. Rotate any key shared in chat.
AI_ENABLED=false
OPENAI_API_KEY=
AI_MODEL_FAST=
AI_MODEL_RECOMMEND=
# Set verified MAXIMUM prices of both selected models before enabling paid calls.
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0
AI_PROJECT_BUDGET_USD=40
AI_USER_DAILY_BUDGET_USD=0.5
AI_USER_REQUESTS_PER_HOUR=20
AI_PROJECT_REQUESTS_PER_DAY=500
AI_TIMEOUT_MS=7000
AI_MAX_OUTPUT_TOKENS=800
AI_MAX_INPUT_BYTES=24000
AI_RETENTION_DAYS=30

# Optional recommendation weights JSON (normalized by the server). See contracts/CAREER.md.
# RECOMMENDATION_WEIGHTS={"critical":0.35,"other":0.20,"goal":0.15,"history":0.15,"availability":0.15}

# OIDC requires HTTPS APP_ORIGIN and COOKIE_SECURE=true.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_TRUSTED_ORIGINS=

# Server-managed relay targets; no arbitrary URLs are accepted in API requests.
# Shape: {"relay":{"url":"https://relay.example/api","secret":"...at least 16 chars..."}}
INTEGRATION_TARGETS_JSON={}
MESSENGER_TARGET_KEY=
WORKER_DELIVERY_ENABLED=false

# NVIDIA / NIM remains deferred. No GPU or NIM adapter is started by this project.
