# Local backend configuration. Copy only when Back/.env does not exist.
API_PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://career_quest:career_quest_local_only@localhost:5433/career_quest
DEMO_MODE=true
COOKIE_SECURE=false
# Set the directory containing the dataset; resolved relative to Back/.
DATASET_PATH=./data

# disabled | openai | nim; these settings require the future backend adapter.
AI_PROVIDER=disabled
OPENAI_API_KEY=
AI_MODEL_FAST=
AI_MODEL_RECOMMEND=
AI_SPEND_CAP_USD=40
AI_REQUEST_TIMEOUT_MS=8000

# Private SSH-forwarded NIM endpoint when API runs directly on the Mac.
NIM_BASE_URL=http://127.0.0.1:8000/v1
NIM_MODEL=
NIM_API_KEY=
